{
  "name": "nothing-gets-lost",
  "private": true,
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "services/*", "ui"],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && npm run typecheck --workspace @ngl/ui",
    "migrate": "tsx packages/db/src/migrate.ts"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.2",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
