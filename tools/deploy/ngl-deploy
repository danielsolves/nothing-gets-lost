#!/usr/bin/env bash
# tools/deploy/ngl-deploy
#
# where: installed on the deploy host as /usr/local/bin/ngl-deploy. It is the only
#   command the GitHub deploy key is permitted to run, forced by the `command="..."`
#   prefix in authorized_keys. See tools/deploy/README.md.
# what: fast-forward /opt/nothing-gets-lost to origin/main, rebuild every image
#   including the one-shot migrator, bring the stack up, then prove the database
#   actually moved before reporting success.
# why: a green `migrate` container proves the migrator found nothing new IN ITS OWN
#   IMAGE. It does not prove the database is current. Those two only coincide when
#   the image was rebuilt after the pull, so the rebuild is explicit here and the
#   proof is a query against schema_migrations rather than an exit code.

set -euo pipefail

# C collation everywhere. The shell sorts the migration filenames on disk and
# Postgres sorts the applied ones; both sides have to agree on what "last" means.
export LC_ALL=C

APP_DIR=/opt/nothing-gets-lost
MIGRATIONS_SUBDIR=packages/db/migrations
REMOTE=origin
BRANCH=main
WAIT_TIMEOUT=600

# Every service in docker-compose.yml that has a `build:` section, in build order.
#
# This list is written out by hand on purpose rather than derived at runtime.
# `docker compose ps` does not list `migrate`, because migrate exits the moment it
# has finished, and that is precisely how it was left out of a rebuild once before.
#
# Order matters twice over. `migrate` is first because it is the cheapest image and
# the one whose staleness breaks the deploy, so it should be the first thing to
# fail; its dependency stage is byte-identical to every other service Dockerfile,
# so building it first fills the layer cache the other eight reuse. `ui` is last
# because it is the only Vite build and the hungriest for memory.
BUILD_SERVICES=(
  migrate
  egress-gate
  ledger
  mailer
  extractor
  mediator
  api
  mcp
  ui
)

# Build targets plus `db`, which is a pulled image (postgres:16-alpine) and has
# nothing to build. Verified against docker-compose.yml on every run so that a
# service added to compose but not added to BUILD_SERVICES stops the deploy instead
# of quietly never being rebuilt.
EXPECTED_SERVICES=(api db egress-gate extractor ledger mailer mcp mediator migrate ui)

log() {
  printf '==> %s\n' "$*"
}

fail() {
  printf 'ngl-deploy: FAILED: %s\n' "$*" >&2
  exit 1
}

# Only one deploy at a time. The lock is taken on the deployment directory itself
# via a read-only file descriptor, so there is no lock file to create at install
# time and no directory that has to be writable by the deploy user.
take_lock() {
  exec 9<"$APP_DIR"
  flock --nonblock 9 \
    || fail "another ngl-deploy is already running against $APP_DIR"
}

preflight() {
  command -v docker >/dev/null 2>&1 || fail 'docker is not on PATH'
  command -v git >/dev/null 2>&1 || fail 'git is not on PATH'
  command -v flock >/dev/null 2>&1 || fail 'flock is not on PATH (install util-linux)'
  docker compose version >/dev/null 2>&1 \
    || fail 'the docker compose v2 plugin is not available to this user'

  [ -d "$APP_DIR" ] || fail "$APP_DIR does not exist"
  [ -d "$APP_DIR/.git" ] \
    || fail "$APP_DIR is not a git clone. Follow the one-time migration in tools/deploy/README.md before enabling the pipeline"
  [ -f "$APP_DIR/docker-compose.yml" ] || fail "$APP_DIR/docker-compose.yml is missing"

  # compose declares .env as optional so that a stranger's fresh clone still boots.
  # On this host its absence is not a fallback, it is an outage in slow motion: the
  # stack would come up on the demo database password with no Stripe, HubSpot,
  # Slack or SMTP credential and would look healthy while doing it.
  [ -f "$APP_DIR/.env" ] \
    || fail "$APP_DIR/.env is missing. Refusing to deploy: the stack would silently start on demo credentials"
}

# Guards against the explicit BUILD_SERVICES list drifting away from compose.
check_service_list() {
  local actual expected
  actual="$(docker compose config --services | sort | tr '\n' ' ')"
  expected="$(printf '%s\n' "${EXPECTED_SERVICES[@]}" | sort | tr '\n' ' ')"

  if [ "$actual" != "$expected" ]; then
    printf 'ngl-deploy: docker-compose.yml no longer matches the build list.\n' >&2
    printf '  compose has: %s\n' "$actual" >&2
    printf '  expected   : %s\n' "$expected" >&2
    fail 'update BUILD_SERVICES and EXPECTED_SERVICES in /usr/local/bin/ngl-deploy'
  fi
}

sync_repo() {
  local branch dirty

  branch="$(git rev-parse --abbrev-ref HEAD)"
  [ "$branch" = "$BRANCH" ] \
    || fail "$APP_DIR is on branch '$branch', expected '$BRANCH'"

  # Tracked files only. .env is gitignored, so it never shows up here and a pull
  # can never touch it.
  dirty="$(git status --porcelain --untracked-files=no)"
  if [ -n "$dirty" ]; then
    printf 'ngl-deploy: local modifications to tracked files in %s:\n' "$APP_DIR" >&2
    printf '%s\n' "$dirty" >&2
    fail 'refusing to deploy over uncommitted changes; resolve them by hand first'
  fi

  BEFORE_REV="$(git rev-parse HEAD)"
  log "pulling $REMOTE/$BRANCH (fast-forward only)"
  git pull --ff-only "$REMOTE" "$BRANCH"
  AFTER_REV="$(git rev-parse HEAD)"

  if [ "$BEFORE_REV" = "$AFTER_REV" ]; then
    log "already at $(git rev-parse --short HEAD), rebuilding anyway"
  else
    log "moved $(git rev-parse --short "$BEFORE_REV") -> $(git rev-parse --short "$AFTER_REV")"
    git --no-pager log --oneline "$BEFORE_REV..$AFTER_REV"
  fi
}

# One service per invocation. The host is memory constrained, and `docker compose
# build` with no service argument hands all nine Dockerfiles to BuildKit at once,
# which means nine concurrent `npm ci` runs. Serialising costs wall clock and buys
# not being OOM killed halfway through.
build_images() {
  local service
  for service in "${BUILD_SERVICES[@]}"; do
    log "building $service"
    docker compose build "$service"
  done
}

start_stack() {
  log 'starting the stack and waiting for health'
  docker compose up -d --wait --wait-timeout "$WAIT_TIMEOUT"
}

# Runs psql inside the db container. The password is read from the container's own
# environment by the inner shell, so it is never an argument of any process on the
# host and never reaches this script's output. The SQL is passed as a positional
# parameter rather than interpolated into the inner script.
psql_query() {
  docker compose exec -T db sh -c '
    PGPASSWORD="$POSTGRES_PASSWORD" exec psql \
      --no-psqlrc --quiet --no-align --tuples-only \
      --set ON_ERROR_STOP=1 \
      --host 127.0.0.1 \
      --username "$POSTGRES_USER" \
      --dbname "$POSTGRES_DB" \
      --command "$1"
  ' ngl-deploy "$1"
}

# The point of the whole script. `migrate` exiting 0 is not evidence, so the
# database is asked directly what it has applied and the answer is compared with
# what is on disk in this checkout.
verify_migrations() {
  local -a files=()
  local path present applied_last applied_count on_disk_last on_disk_count
  local applied_all missing extra

  shopt -s nullglob
  for path in "$MIGRATIONS_SUBDIR"/*.sql; do
    files+=("$(basename "$path")")
  done
  shopt -u nullglob

  [ "${#files[@]}" -gt 0 ] \
    || fail "no .sql files found in $APP_DIR/$MIGRATIONS_SUBDIR"

  on_disk_count="${#files[@]}"
  on_disk_last="${files[on_disk_count - 1]}"

  present="$(psql_query "SELECT to_regclass('public.schema_migrations') IS NOT NULL")"
  [ "$present" = "t" ] \
    || fail 'schema_migrations does not exist: the migrator never ran against this database'

  applied_count="$(psql_query 'SELECT count(*) FROM schema_migrations')"
  applied_last="$(psql_query 'SELECT filename FROM schema_migrations ORDER BY filename COLLATE "C" DESC LIMIT 1')"

  log "migrations on disk: $on_disk_count, last is $on_disk_last"
  log "migrations applied : $applied_count, last is $applied_last"

  if [ "$applied_last" = "$on_disk_last" ] && [ "$applied_count" = "$on_disk_count" ]; then
    log 'database matches the checkout'
    return 0
  fi

  applied_all="$(psql_query 'SELECT filename FROM schema_migrations ORDER BY filename COLLATE "C"')"
  # sed drops the blank line printf produces when the table is present but empty.
  missing="$(comm -23 <(printf '%s\n' "${files[@]}") <(printf '%s\n' "$applied_all" | sed '/^$/d'))"
  extra="$(comm -13 <(printf '%s\n' "${files[@]}") <(printf '%s\n' "$applied_all" | sed '/^$/d'))"

  printf 'ngl-deploy: the database did not move to match this checkout.\n' >&2
  if [ -n "$missing" ]; then
    printf '  on disk but never applied:\n' >&2
    printf '%s\n' "$missing" | sed 's/^/    /' >&2
  fi
  if [ -n "$extra" ]; then
    printf '  applied but absent from this checkout (the checkout went backwards):\n' >&2
    printf '%s\n' "$extra" | sed 's/^/    /' >&2
  fi
  printf '  The usual cause is a migrate image that was not rebuilt: the .sql files\n' >&2
  printf '  are baked into it, so a git pull alone only puts them on the host disk.\n' >&2
  printf '  Inspect from your own shell on the host, not from here:\n' >&2
  printf '    cd %s && docker compose logs migrate\n' "$APP_DIR" >&2
  fail 'schema_migrations does not match packages/db/migrations'
}

main() {
  printf 'ngl-deploy: starting at %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  # Audit line. The key is restricted with command=, so whatever the client asked
  # for was discarded; recording it makes a stolen key being probed visible.
  printf 'ngl-deploy: requested command (ignored): %q\n' "${SSH_ORIGINAL_COMMAND:-none}"

  preflight
  cd "$APP_DIR"
  take_lock
  check_service_list
  sync_repo
  build_images
  start_stack
  verify_migrations

  log 'container status (--all, so the exited migrate container is visible too)'
  docker compose ps --all

  printf 'ngl-deploy: OK, %s is live at %s\n' \
    "$(git rev-parse --short HEAD)" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
}

main "$@"
