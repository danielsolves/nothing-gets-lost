DATABASE_URL=postgres://ngl:ngl@localhost:5432/ngl
DATABASE_URL_READONLY=postgres://ngl_ro:ngl_ro@localhost:5432/ngl

# The two lines above carry the demo passwords, which is fine on a laptop and not
# on a public host. Setting these two makes docker compose build both urls from
# them instead, and the migrator moves the read-only role onto the second one.
# The read-only url is what the MCP server connects with, and the only thing it is
# given: it answers questions about the backlog and must not hold a credential that
# could write.
#   openssl rand -base64 24 | tr -d '+/='
# Letters, digits, underscore, dot, tilde or hyphen, 16 or more. Postgres reads the
# first one only when it initialises an empty volume, so set it before the first
# `docker compose up` or drop the volume afterwards. Leave both empty for a clone
# that should just start.
DATABASE_PASSWORD=
DATABASE_READONLY_PASSWORD=

# Stripe — TEST MODE ONLY. The app refuses to start with a live key.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# HubSpot — private app token for the portal this demo owns.
# There is no OAuth app any more: a visitor could once connect their own portal, and
# that came out. Nobody hands a portfolio page write access to their CRM, and asking
# cost a store of other people's credentials for no user at all.
HUBSPOT_TOKEN=pat-xxx

# Slack — bot token for the open demo channel.
# This app needs chat:write AND channels:history. The delivery reads the channel
# back to recognise its own marker before posting; without the history scope every
# Slack delivery fails with missing_scope.
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_CHANNEL_ID=C000000

# Mail — any SMTP provider. Sender domain needs SPF and DKIM,
# otherwise the confirmation mail lands in spam and the strongest
# proof of the whole demo is gone.
SMTP_URL=smtp://user:pass@host:587
MAIL_FROM=demo@example.com

# Model for extracting free-text orders. Leave empty to run on
# recorded answers from fixtures/extractions.json.
ANTHROPIC_API_KEY=

# Where the Stripe webhook comes back to. Behind a domain this is the public https
# url, not localhost.
PUBLIC_BASE_URL=http://localhost:5173

# Where the page, the api, the MCP server and Postgres are published on the host.
# Only worth setting on a machine that already uses these numbers for something
# else; inside the compose network the ports never move, so nothing else changes
# with them.
API_PORT=
UI_PORT=
DB_PORT=
MCP_PORT=
